# Claude (Anthropic) is Disha's reasoning brain: learning-path generation,
# lesson planning, adaptation, and work-mapping. REQUIRED.
# Get a key at https://console.anthropic.com. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: override the Claude model without a code change (default: claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Sarvam AI powers voice/TTS, translation and speech-to-text (multilingual).
# Optional for the core Disha demo; required only for the teaching-video slice.
# Get a key at https://www.sarvam.ai. Never commit a real key.
SARVAM_API_KEY=

# Optional: override the SQLite file location. Defaults to data/ai-teacher.sqlite.
# DB_PATH=./data/ai-teacher.sqlite

# Optional: override where teaching-video artifacts (narration WAVs, per-scene
# and final MP4s) are cached. Defaults to data/video-cache. See docs/VIDEO.md.
# VIDEO_CACHE_DIR=./data/video-cache
